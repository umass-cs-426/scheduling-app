<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Scheduler Demo</title>
    <link
      rel="stylesheet"
      href="/styles.css" />
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.8/dist/htmx.min.js" defer></script>
    <script src="https://unpkg.com/htmx-ext-json-enc@2.0.1/json-enc.js" defer></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </head>
  <body>
    <h1>Scheduler Demo</h1>

    <section>
      <h2>Events</h2>

      <p class="hint">Create an event, then click Load Events to see it.</p>

      <form
        id="create-event-form"
        hx-post="/events/create"
        hx-ext="json-enc"
        hx-headers='{"Content-Type":"application/json"}'
        hx-target="#events"
        hx-swap="outerHTML">
        <input
          name="title"
          placeholder="Title" />
        <input
          name="date"
          type="date"
          value="<%= (defaults && defaults.date) || '' %>"
          placeholder="YYYY-MM-DD" />
        <button type="submit">Create Event</button>
      </form>

      <p>
        <button
          hx-get="/events/fragment"
          hx-target="#events"
          hx-swap="outerHTML">
          Refresh Events
        </button>
      </p>

      <%- include('partials/events-list', { events }) %>
    </section>

    <section>
      <h2>Availability</h2>

      <p class="hint">Select an event to target availability requests.</p>
      <p class="hint">This is required before submitting availability.</p>

      <%- include('partials/event-select', { events, oob: false }) %>

      <form
        id="availabilityForm"
        hx-post="/availability/create"
        hx-ext="json-enc"
        hx-headers='{"Content-Type":"application/json"}'
        hx-target="#availability-list"
        hx-swap="outerHTML"
        x-data="{
          startTime: '<%= (defaults && defaults.startTime) || '' %>',
          endTime: '<%= (defaults && defaults.endTime) || '' %>',
          syncEndTime() {
            if (!this.startTime) return
            const [h, m] = this.startTime.split(':').map(Number)
            if (Number.isNaN(h) || Number.isNaN(m)) return
            const date = new Date()
            date.setHours(h, m, 0, 0)
            date.setHours(date.getHours() + 1)
            const pad2 = (v) => String(v).padStart(2, '0')
            this.endTime = `${pad2(date.getHours())}:${pad2(date.getMinutes())}`
          }
        }">
        <input
          name="name"
          placeholder="Your name"
          required />
        <input
          name="startTime"
          type="time"
          value="<%= (defaults && defaults.startTime) || '' %>"
          placeholder="Start (HH:MM)"
          step="60"
          required
          x-model="startTime"
          x-on:input.debounce.150="syncEndTime()" />
        <input
          name="endTime"
          type="time"
          value="<%= (defaults && defaults.endTime) || '' %>"
          placeholder="End (HH:MM)"
          step="60"
          required
          x-model="endTime" />
        <button type="submit">Submit Availability</button>
      </form>

      <p>
        <button
          id="loadAvailability"
          hx-get="/availability/fragment"
          hx-target="#availability-list"
          hx-swap="outerHTML">
          Refresh Availability
        </button>
      </p>

      <div
        id="availability-list"
        hx-get="/availability/fragment"
        hx-trigger="load, events-updated from:body">
        Loading availability...
      </div>
    </section>

  </body>
</html>
