{
  "name": "scheduling-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "cast:record": "bash -c 'name=${1:-demo}.cast; mkdir -p slides/_test/_template2/public/casts; env PS1=\"$ \" asciinema rec -q -c \"bash --noprofile --norc\" \"slides/_test/_template2/public/casts/$name\"' --"
  },
  "dependencies": {
    "@slidev/theme-default": "^0.25.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@slidev/cli": "^52.12.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "dotenv": "^17.3.1",
    "slidev-addon-asciinema": "^0.1.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
